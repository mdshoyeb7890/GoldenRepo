<?xml version="1.0" encoding="UTF-8"?>
<!-- Set status="DEBUG" temporarily to see Splunk appender errors in console; then set back to WARN -->
<Configuration status="WARN">

    <Appenders>

        <!-- Console appender -->
        <Console name="Console" target="SYSTEM_OUT">
            <PatternLayout pattern="%d{ISO8601} %-5level [%t] %c: %msg%n"/>
        </Console>

        <!-- Splunk HTTP Event Collector appender (Log4j2) -->
        <!-- Override via env: SPLUNK_HEC_URL, SPLUNK_HEC_TOKEN (optional, for production) -->
        <SplunkHttp
                name="Splunk"
                url="${env:SPLUNK_HEC_URL:-http://localhost:8088/services/collector}"
                token="${env:SPLUNK_HEC_TOKEN:-8127492c-a7c7-4d62-98dd-238ba0e4b99f}"
                index="inventory_api_dev"
                source="inventory-service"
                sourcetype="spring-boot"
                host="inventory-service"
                disableCertificateValidation="true">

            <!-- Layout for the event body sent to Splunk -->
            <PatternLayout pattern="%d{ISO8601} %-5level %c: %msg"/>

        </SplunkHttp>

    </Appenders>

    <Loggers>

        <Root level="info">
            <AppenderRef ref="Console"/>
            <AppenderRef ref="Splunk"/>
        </Root>

    </Loggers>

</Configuration>